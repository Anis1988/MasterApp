# Copy this file to .env.local for `npm run dev` (.env.local is never committed). On Vercel: Settings → Environment Variables.

# Required: the access code you type to open the page. Make up a long password.
APP_ACCESS_TOKEN=pick-any-long-password

# GitHub fine-grained token, all repositories. Permissions: Actions (read and write), Contents (read).
# Commits, releases, checks, and turning scheduled workflows off/on.
GITHUB_TOKEN=
# Only if your repos move to another account or organization.
GITHUB_OWNER=Anis1988

# Vercel → Account Settings → Tokens. Deploy status and the pause switch for Vercel apps.
VERCEL_TOKEN=
# Only if the projects are in a Vercel team.
VERCEL_TEAM_ID=

# Optional: Netlify → User settings → Applications → Personal access tokens. Deploy status for Netlify sites.
NETLIFY_TOKEN=

# Optional: Claude Console → Settings → Admin keys (sk-ant-admin…, organizations only). Claude spend for all apps.
ANTHROPIC_ADMIN_KEY=
